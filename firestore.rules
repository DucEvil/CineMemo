rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin'
        );
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function createOwnUserDoc() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function readOwnUserDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function keepUserIdStable() {
      return request.resource.data.userId == resource.data.userId;
    }

    function canCreateShowtimeReminder(reminderId) {
      return createOwnUserDoc() &&
        request.resource.data.bookingId == reminderId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.scheduledFor is timestamp &&
        request.resource.data.showStartAt is timestamp &&
        request.resource.data.targetTokens is list &&
        request.resource.data.targetTokens.size() > 0;
    }

    function canUpdateShowtimeReminder() {
      return readOwnUserDoc() &&
        keepUserIdStable() &&
        request.resource.data.bookingId == resource.data.bookingId;
    }

    function canWriteShowtimeSeatBooking(showtimeId, bookingId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      return isSignedIn() &&
        exists(bookingPath) &&
        request.resource.data.bookingId == bookingId &&
        request.resource.data.showtimeId == showtimeId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.seats == get(bookingPath).data.seats &&
        get(bookingPath).data.userId == request.auth.uid &&
        get(bookingPath).data.showtimeId == showtimeId;
    }

    function canWriteShowtimeSeatReservation(showtimeId, reservationId) {
      let reservationPath = /databases/$(database)/documents/reservations/$(reservationId);
      return isSignedIn() &&
        exists(reservationPath) &&
        request.resource.data.reservationId == reservationId &&
        request.resource.data.showtimeId == showtimeId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.seats == get(reservationPath).data.seats &&
        request.resource.data.expiresAt == get(reservationPath).data.expiresAt &&
        get(reservationPath).data.userId == request.auth.uid &&
        get(reservationPath).data.showtimeId == showtimeId;
    }

    // User profile
    match /users/{userId} {
      allow create: if isOwnerUid(userId);
      allow read, update, delete: if isOwnerUid(userId) || isAdmin();
    }

    // Public catalog data
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /showtimes/{showtimeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /theaters/{theaterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booking/payment domain
    match /bookings/{bookingId} {
      allow create: if createOwnUserDoc();
      allow read: if readOwnUserDoc() || isAdmin();
      allow update: if (readOwnUserDoc() && keepUserIdStable()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /showtimeReminders/{reminderId} {
      allow create: if canCreateShowtimeReminder(reminderId);
      allow read: if readOwnUserDoc() || isAdmin();
      allow update: if canUpdateShowtimeReminder() || isAdmin();
      allow delete: if readOwnUserDoc() || isAdmin();
    }

    match /reservations/{reservationId} {
      allow create: if createOwnUserDoc();
      allow read: if readOwnUserDoc() || isAdmin();
      allow update: if (readOwnUserDoc() && keepUserIdStable()) || isAdmin();
      allow delete: if readOwnUserDoc() || isAdmin();
    }

    // Public seat-state by showtime (no booking detail exposure)
    match /showtimeSeatStates/{showtimeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /bookings/{bookingId} {
        allow read: if true;
        allow create, update: if canWriteShowtimeSeatBooking(showtimeId, bookingId);
        allow delete: if isAdmin();
      }

      match /reservations/{reservationId} {
        allow read: if true;
        allow create, update: if canWriteShowtimeSeatReservation(showtimeId, reservationId);
        allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      }
    }

    match /transactions/{transactionId} {
      allow create: if createOwnUserDoc();
      allow read: if readOwnUserDoc() || isAdmin();
      allow update: if (readOwnUserDoc() && keepUserIdStable()) || isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews can be public for timeline view
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if createOwnUserDoc();
      allow update: if (readOwnUserDoc() && keepUserIdStable()) || isAdmin();
      allow delete: if readOwnUserDoc() || isAdmin();
    }

    // Cinema diary logs: public if visibility == 'public', otherwise owner/admin only
    match /logs/{logId} {
      allow read: if resource.data.visibility == 'public' || readOwnUserDoc() || isAdmin();
      allow create: if createOwnUserDoc();
      allow update, delete: if (readOwnUserDoc() && keepUserIdStable()) || isAdmin();
    }

    // Favorites / watchlist records
    match /favorites/{favoriteId} {
      allow create: if createOwnUserDoc();
      allow read: if readOwnUserDoc() || isAdmin();
      allow update, delete: if (readOwnUserDoc() && keepUserIdStable()) || isAdmin();
    }

    // Deny everything else by default
    // AI requests (created by client apps submitting prompts to Gemini)
    match /aiRequests/{requestId} {
      // Allow clients to create requests (no sensitive data expected).
      allow create: if true;
      // Allow the request owner or admins to read the request.
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      // Only admins may update or delete requests.
      allow update, delete: if isAdmin();
    }

    // The extension expects clients to create a document in `generate` with
    // a `prompt` field. The extension will write back the `response` field on
    // the same document. Allow clients to create generate docs and read the
    // result if they are the owner (or admins). Writes/updates after creation
    // remain admin-only to avoid tampering with outputs.
    match /generate/{genId} {
      // Allow clients to create a new generate doc with a prompt.
      allow create: if true;

      // Allow read for admins, the owner inferred from `userId`, or public
      // guest requests. This ensures guest chat can read back the response.
      allow read: if isAdmin() || (
        isSignedIn() && (
          (resource.data.userId is string && resource.data.userId == request.auth.uid)
          || ((resource.data.requestId is string) &&
              (get(/databases/$(database)/documents/aiRequests/$(resource.data.requestId)).data.userId == request.auth.uid))
        )
      ) ||
      (!isSignedIn() && resource.data.userId == 'guest');

      // Allow the owner to update prompt data for the same generate document.
      // This is safe because response writes are still controlled by the extension.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.userId is string && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      ) || (
        !isSignedIn() && resource.data.userId == 'guest' &&
        request.resource.data.userId == 'guest'
      );

      allow delete: if isAdmin();
    }

    // AI Conversations - store chat history and messages
    match /aiConversations/{convId} {
      // Allow anyone (signed in or guest) to create conversations
      allow create: if true;
      
      // Allow reading conversations
      allow read: if true;
      
      // Only admins can update/delete conversations
      allow update, delete: if isAdmin();
      
      // Messages subcollection within each conversation
      match /messages/{msgId} {
        // Allow anyone to add messages (user or assistant)
        allow create: if true;
        
        // Allow reading messages
        allow read: if true;
        
        // Only admins can update/delete messages
        allow update, delete: if isAdmin();
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
