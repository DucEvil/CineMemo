{
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"storage": {
		"rules": "storage.rules"
	},
	"functions": {
		"source": "functions",
		"runtime": "nodejs20",
		"ignore": [
			"node_modules",
			".git",
			"firebase-debug.log",
			"firebase-debug.*.log"
		]
	},
	"flutter": {
		"platforms": {
			"android": {
				"default": {
					"projectId": "cinememo-app",
					"appId": "1:150666245622:android:43a5b0781a99635d0343d7",
					"fileOutput": "android/app/google-services.json"
				}
			},
			"dart": {
				"lib/config/firebase_options.dart": {
					"projectId": "cinememo-app",
					"configurations": {
						"android": "1:150666245622:android:43a5b0781a99635d0343d7",
						"web": "1:150666245622:web:ca0857c1fbd16b740343d7",
						"windows": "1:150666245622:web:fb363a7b07ddaa410343d7"
					}
				}
			}
		}
	},
	"hosting": {
		"public": "build/web",
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	}
}