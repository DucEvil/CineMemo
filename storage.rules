// Firebase Storage security rules for CineMemo
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars: public read, authenticated write, image-only, <= 5MB
    match /cinememo/avatars/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && resource.metadata.uid == request.auth.uid;
    }

    // Reviews images: public read, authenticated write, image-only, <= 10MB
    match /cinememo/reviews/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && resource.metadata.uid == request.auth.uid;
    }

    // Bookings (ticket images): only owner read/write/delete
    match /cinememo/bookings/{file} {
      allow read, write, delete: if request.auth != null
                                 && (
                                   resource.metadata.uid == request.auth.uid
                                   || request.resource.metadata.uid == request.auth.uid
                                 );
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
