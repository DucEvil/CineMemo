# App
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# Database
DB_USER=app_user
DB_PASS=app_pass
DB_NAME=movie_app
DB_HOST=127.0.0.1
DB_PORT=3306

# For Cloud SQL Unix socket
DB_SOCKET_DIR=/cloudsql
DB_INSTANCE_CONNECTION_NAME=project:region:instance
